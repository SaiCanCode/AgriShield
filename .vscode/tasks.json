{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Firmware: compile (ESP32)",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "esp32:esp32:esp32doit-devkit-v1",
        "lib/agrishield_firmware"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
